<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ActorMessage\**" />
    <Compile Remove="Actors\BattleZone\**" />
    <Compile Remove="Actors\Inventory\**" />
    <Compile Remove="Actors\Village\**" />
    <EmbeddedResource Remove="ActorMessage\**" />
    <EmbeddedResource Remove="Actors\BattleZone\**" />
    <EmbeddedResource Remove="Actors\Inventory\**" />
    <EmbeddedResource Remove="Actors\Village\**" />
    <None Remove="ActorMessage\**" />
    <None Remove="Actors\BattleZone\**" />
    <None Remove="Actors\Inventory\**" />
    <None Remove="Actors\Village\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.40" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.3" />
    <PackageReference Include="PowerArgs" Version="4.0.3" />
    <PackageReference Include="ServerEngine.AsciiBanner" Version="1.1.0" />
    <PackageReference Include="ServerEngine.Config" Version="1.0.4" />
    <PackageReference Include="ServerEngine.Core" Version="1.0.9" />
    <PackageReference Include="ServerEngine.GeoIP" Version="1.0.0" />
    <PackageReference Include="ServerEngine.Network" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Framework\Framework.Config\Framework.Config.csproj" />
    <ProjectReference Include="..\..\Framework\Framework.Core\Framework.Core.csproj" />
  </ItemGroup>

</Project>
